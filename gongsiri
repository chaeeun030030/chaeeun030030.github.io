   '<div class="panel"><h4>🏘️ 주변 상가 (반경 200m)</h4><div class="near-chips">'+nearChips+'</div></div>'+
   '<div class="panel"><h4>🚶 시간대별 유동인구 (추정)</h4><div class="chart">'+chart+'</div>'+
   '<div class="peak-note">유동인구 피크 : 점심 12~14시 · 저녁 18~21시</div></div>'+
   '<div class="ai-card"><span class="tag">AI 추천 업종 · 적합도 '+s.ai.score+'점</span>'+
   '<h3>'+s.ai.rec+'</h3>'+
   '<ul class="why">'+s.ai.why.map(w=>'<li>'+w+'</li>').join('')+'</ul>'+
   '<div class="caution"><b>⚠️ 계약 전 확인하세요</b><ul>'+s.ai.caution.map(c=>'<li>'+c+'</li>').join('')+'</ul></div></div>'+
   '<div class="panel"><h4>💰 예상 손익 시나리오</h4>'+
   '<div class="calc-row">'+
    '<select id="c-visit"><option value="30">하루 방문 30명</option><option value="50" selected>하루 방문 50명</option><option value="80">하루 방문 80명</option></select>'+
    '<select id="c-conv"><option value="10">구매 전환 10%</option><option value="15" selected>구매 전환 15%</option><option value="20">구매 전환 20%</option></select>'+
   '</div>'+
   '<div class="calc-row">'+
    '<select id="c-avg"><option value="8000">객단가 8천 원</option><option value="12000" selected>객단가 1.2만 원</option><option value="20000">객단가 2만 원</option></select>'+
    '<select id="c-cost"><option value="30">운영비 월 30만 원</option><option value="50" selected>운영비 월 50만 원</option></select>'+
   '</div>'+
   '<div class="calc-out" id="calc-out"></div>'+
   '<div class="calc-note">※ 방문 수·전환율·객단가·비용은 이용자가 조정하는 가정값입니다. 검증된 예측이 아니라 참고용 시나리오이며, 월 26일 영업 기준으로 계산합니다.</div>'+
   '</div>';
  document.getElementById('screen-detail').classList.add('active');
  document.getElementById('detail-body').scrollTop=0;
  window._cur=s;
  calcScenario();
  ['c-visit','c-conv','c-avg','c-cost'].forEach(i=>document.getElementById(i).addEventListener('change',calcScenario));
}
function closeDetail(){document.getElementById('screen-detail').classList.remove('active')}
function calcScenario(){
  const s=window._cur;if(!s)return;
  const v=+document.getElementById('c-visit').value;
  const c=+document.getElementById('c-conv').value/100;
  const a=+document.getElementById('c-avg').value;
  const cost=+document.getElementById('c-cost').value;
  const rev=Math.round(v*c*a*26/10000);
  const profit=rev-s.rent-cost;
  const cls=profit>=0?'':' style="color:#c0392b"';
  document.getElementById('calc-out').innerHTML=
   '<div><span>예상 월 매출</span><b>'+rev+'만 원</b></div>'+
   '<div><span>월 임대료</span><span>-'+s.rent+'만 원</span></div>'+
   '<div><span>기타 운영비</span><span>-'+cost+'만 원</span></div>'+
   '<div style="border-top:1px dashed var(--line);margin-top:6px;padding-top:8px"><span><b>예상 월 순이익</b></span><b'+cls+'>'+profit+'만 원</b></div>';
}
function runMatch(){
  const purpose=document.querySelector('#m-purpose .opt.on').dataset.v;
  const budget=+document.getElementById('m-budget').value;
  const period=document.querySelector('#m-period .opt.on').dataset.v;
  const facs=[...document.querySelectorAll('#m-fac .opt.on')].map(o=>o.dataset.v);
  let list=STORES.filter(s=>s.rent<=budget);
  if(period.indexOf('1주')===0||period.indexOf('1~3')===0)list=list.filter(s=>s.short);
  facs.forEach(f=>{list=list.filter(s=>s.fac.includes(f))});
  list.sort((a,b)=>b.fit-a.fit);
  const el=document.getElementById('match-results');
  if(list.length===0){
    el.innerHTML='<div class="panel" style="text-align:center;margin-top:14px"><div style="font-size:30px">🔍</div><b>조건에 맞는 공간이 없습니다</b><p style="font-size:12px;color:var(--gray);margin-top:5px">예산이나 필수 조건을 조정해 보세요</p></div>';
  }else{
    el.innerHTML='<div class="sec-title"><h3>매칭 결과 '+list.length+'곳</h3><button onclick="document.getElementById(\'match-results\').innerHTML=\'\'">초기화</button></div>'+list.map(s=>storeCard(s)).join('');
  }
  el.scrollIntoView({behavior:'smooth',block:'start'});
}
function openModal(t,m){document.getElementById('modal-title').textContent=t;document.getElementById('modal-msg').innerHTML=m;document.getElementById('modal-bg').classList.add('active')}
function closeModal(){document.getElementById('modal-bg').classList.remove('active')}
document.querySelectorAll('#m-purpose .opt, #m-period .opt').forEach(o=>o.addEventListener('click',()=>{
  [...o.parentNode.children].forEach(c=>c.classList.remove('on'));o.classList.add('on');
}));
document.querySelectorAll('#m-fac .opt').forEach(o=>o.addEventListener('click',()=>o.classList.toggle('on')));
</script>
</body>
</html>
