  try{
    mapObj=L.map('map',{zoomControl:false}).setView([35.1806,126.9041],17);
    L.control.zoom({position:'bottomright'}).addTo(mapObj);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap'}).addTo(mapObj);
